# ==============================================================================
# Bridge Portal - Master Environment Configuration Template
# ==============================================================================

# System Environment
ENVIRONMENT=development
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# PostgreSQL Database (Tenancy enforced via Row-Level Security)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=ikonex_admin
DB_PASSWORD=ikonex_secure_pass
DB_NAME=ikonex_academy
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Optional local PostgreSQL integration tests; required in CI. Dedicated test
# server only: the harness creates/drops databases and roles as a superuser.
# DEV05_TEST_DATABASE_URL=postgres://ikonex_admin:ikonex_secure_pass@localhost:5432/postgres?sslmode=disable

# ------------------------------------------------------------------------------
# Redis & Asynq Job Queue (SMS, STK push polling, payment reminders)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Go Backend Server
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
BACKEND_HOST=0.0.0.0
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_bytes
JWT_EXPIRY_HOURS=24
INTERNAL_SERVICE_TOKEN=internal_service_secret_token_between_go_and_ai
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
OTP_HMAC_SECRET=replace_with_a_secure_random_string_at_least_32_bytes

# ------------------------------------------------------------------------------
# Next.js Frontend
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# Python AI Service (Mistral LLM integration, zero direct DB access)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
GO_BACKEND_INTERNAL_URL=http://localhost:8080/api/v1/internal
MISTRAL_API_URL=http://localhost:11434/v1 # Ollama or vLLM local endpoint
MISTRAL_MODEL_NAME=mistral-7b-instruct
AI_SERVICE_SECRET_TOKEN=internal_service_secret_token_between_go_and_ai

# ------------------------------------------------------------------------------
# Africa's Talking (SMS / USSD)
# ------------------------------------------------------------------------------
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=replace_with_at_api_key
AFRICASTALKING_SENDER_ID=IKONEX

# ------------------------------------------------------------------------------
# Safaricom Daraja API (M-Pesa Paybill STK Push / C2B — Release 1 Paybill only)
# ------------------------------------------------------------------------------
# Use "sandbox" for development/testing and "production" for live schools.
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=replace_with_daraja_consumer_key
DARAJA_CONSUMER_SECRET=replace_with_daraja_consumer_secret
DARAJA_PASSKEY=replace_with_daraja_passkey
# Base STK callback URL; the backend appends "/<per_request_token>" per STK attempt.
DARAJA_CALLBACK_URL=https://your-domain.co.ke/api/v1/billing/mpesa/callback
# Static callback authentication (C2B confirmation & static STK route):
# Reverse proxy / API gateway must validate Safaricom IP/mTLS, strip client
# X-Callback-Token & Authorization headers, and inject X-Callback-Token.
# Never expose to frontend clients or pass in URL query strings.
MPESA_CALLBACK_TOKEN=replace_with_a_secure_random_callback_secret
# Comma-separated trusted reverse proxy IPs/CIDRs allowed to supply X-Callback-Token.
# Production must set explicit gateway CIDRs (fails closed if empty).
MPESA_TRUSTED_CALLBACK_PROXIES=127.0.0.1/32

# ------------------------------------------------------------------------------
# Biometric Encryption (Per-school envelope encryption key management)
# ------------------------------------------------------------------------------
BIOMETRIC_MASTER_KEY=base64_encoded_32_byte_aes_gcm_master_key
